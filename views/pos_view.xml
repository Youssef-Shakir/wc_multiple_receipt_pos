<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_voip" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.voip</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pos_payment_section']" position="after">
                    <block title="Multiple Time Receipt Print" id="pos_payment_section">
                        <setting id="Restrict" string="Multiple Time Receipt Time Print ?">
                            <field name="pos_multi_receipt_print" colspan="4" readonly="0"/>

                            <field name="pos_receipt_print_time" colspan="4" readonly="0" invisible="pos_multi_receipt_print == False"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>